# .NET / ASP.NET Core .gitignore

# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/

# VS Code (optional)
.vscode/

# Logs
logs/
*.log

# Test results
TestResults/
coverage/

# Environment/config files
.env
.env.*
appsettings.Development.json
appsettings.*.local.json

# System files
.DS_Store
Thumbs.db

# Others
_ReSharper*/
.idea/
*.ncrunch*
*.localhistory/
